<%layout("/layouts/boilerplate")%>
<body>
    <div class="row">
        <div class="col-8 offset-2 " >
            <br>
    <h3>Create a New Listing</h3>

    <form method="POST" action="/listings"novalidate class="needs-validation" enctype="multipart/form-data">
        <div>
             <label for="title" class="form-label">Title</label>
            <input
                name="listing[title]"
                type="text"
                class="form-control"
                placeholder="Add Catchy Title"
                required
            />
            <div class="valid-feedback">looks cool!!</div>
        </div> 
           
      
        <div>
            <label for="description" class="form-label">Description</label>
            <textarea
            name="listing[description]"
            class="form-control"
            placeholder="Add Description"
            required
            ></textarea>
        </div>

        
        
        <div>
            <label for="image" class="form-label">Upload Image</label>
            <input
            name="listing[image][url]"
            type="file"
            class="form-control"
            >
            
        </div>
        
        <div class="row">
             <div class="col-4">
             <label for="price" class="form-label">Price</label>
             <input
            name="listing[price]"
           class="form-control"
           
            placeholder="1200"
            required>
            <div class="invalid-feedback">Please enter vaild price</div>
                </div>
            <div class="col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
            name="listing[country]"
            class="form-control"
            type="text"
            required>
            <div class="invalid-feedback">Please enter the country name</div>
        </div>
        
        </div>
       

        
       
        <div>
            <label for="location" class="form-label">Location</label>
            <input
            name="listing[location]"
            class="form-control"
            type="text"
            required>
            <div class="invalid-feedback">location should be valid</div>
        </div>
        
  
        
        

<br>
        <button class="btn btn-dark add-btn">Add</button>
<br><br>

    </form>
    </div>
    </div>
</body>
